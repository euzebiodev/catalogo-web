# Copie para .env e ajuste. O arquivo .env não vai para o git.
# Teste local: schema catalogo_teste dentro do banco catalogo (cópia do um1).
DATABASE_URL=postgresql://euzebio:SENHA@localhost:5432/catalogo?options=-csearch_path%3Dcatalogo_teste
# Servidor um1 (produção): sem o parâmetro options, usa o schema public.
# DATABASE_URL=postgresql://euzebio:SENHA@192.168.0.229:5432/catalogo

# Pasta com as capas (livro/, gibi/, lp/). Padrão: dados/capas dentro do projeto.
